# Production environment template. Never commit the filled-in copy.
#
# Copy this file to svc/.env.production; keep svc/.env for development.
#
# Native run: from svc, uv run --env-file .env.production python main.py
#   These values override svc/.env, which main.py still loads; any variable
#   left out falls back to its development value, so keep every line below.
#   Only the "Read by the service" section applies.
# Compose (docker compose): pass --env-file svc/.env.production.
#   Compose sets the container paths itself and uses the "Compose bind
#   mounts" section for host paths.
#
# See DEV-SETUP.md, "Production", for both procedures.

# --- Read by the service --------------------------------------------------
SVC_ENVIRONMENT=production
SVC_MIN_DWELL_SECONDS=20

# Native run only; Compose overrides both. Relative paths resolve against svc/.
# SVC_DATA_DIR holds audit.db. To continue existing production history, point
# it at the directory that already contains that audit.db.
SVC_DATA_DIR=.runtime/production
# Copy config/production.example to config/production (git-ignored) and edit
# sensors_config.json for the site hardware.
SVC_CONFIG_DIR=config/production
# Native run only: SVC_HOST defaults to 127.0.0.1. Set 0.0.0.0 to reach the
# HMI from other machines.
# SVC_HOST=0.0.0.0
# Native run only: a JETI file input_path must be inside this directory.
# It defaults to SVC_DATA_DIR.
# SVC_SENSOR_INPUT_DIR=

# 0 disables backups. Native runs write to SVC_DB_BACKUP_DIR directly;
# Compose mounts it at /app/db-backups and requires it to exist already.
SVC_DB_BACKUP_INTERVAL_HOURS=24
SVC_DB_BACKUP_DIR=/absolute/path/to/database/backups

# EKO Modbus TCP and the LiVal capture file are read by the service itself.
SVC_SENSOR_ACQUISITION=embedded
# Required when any enabled device in sensors_config.json is marked
# "acquisition": "external" (T-10A, JETI serial); the Sensor Agent posts with it.
SVC_SENSOR_INGEST_TOKEN=

# Halio needs only these two values. The API is reachable only on the Halio
# network, the trailer LAN the controller is on (no internet access; the
# trailer's other network does not reach Halio), so production must run on a
# machine connected to it.
#
# Halio v3 API on the controller's admin console port (8083), including the
# /api/v3 prefix.
HALIO_API_URL=http://192.0.2.20:8083/api/v3
# The Halio site whose windows and groups this service controls. Every request
# goes to <HALIO_API_URL>/sites/<HALIO_SITE_ID>/..., so a wrong value leaves
# the HMI with no panels. It is site-specific: keep it out of source control.
# Copy it and HALIO_API_URL from LOCAL-DEVELOPMENT.md in the private
# radiantlab/DIAL-Internal-Documentation repository (request access from the
# project partner).
HALIO_SITE_ID=replace-me

# --- Compose bind mounts --------------------------------------------------
# Absolute host paths, read by docker-compose.yml only. Each must already
# exist. On Windows use forward slashes, for example C:/path/to/dir.
SVC_PRODUCTION_DATA_DIR=/absolute/path/to/existing/svc/data
SVC_PRODUCTION_CONFIG_DIR=/absolute/path/to/production/config
# The active, line-oriented LiVal capture file (a file, not a directory). Its
# suffix may be .xlsx; Compose mounts it read-only. With no LiVal capture
# running, /dev/null (Linux host) satisfies the required mount.
SVC_JETI_CAPTURE_PATH=/absolute/path/to/JETI_Specbos_capture.xlsx
