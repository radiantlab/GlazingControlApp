SVC_PRODUCTION_DATA_DIR=C:/absolute/path/to/existing/svc/data
SVC_PRODUCTION_CONFIG_DIR=C:/absolute/path/to/production/config
SVC_DB_BACKUP_DIR=C:/absolute/path/to/database/backups
SVC_DB_BACKUP_INTERVAL_HOURS=24
# Exact Windows path to the active, line-oriented LiVal capture file. Its
# suffix may be .xlsx; Compose mounts it read-only into the app container.
SVC_JETI_CAPTURE_PATH=C:/Users/replace-me/Desktop/JETI_Specbos_capture.xlsx
# EKO Modbus TCP and the mounted LiVal file are read by the app container.
SVC_SENSOR_ACQUISITION=embedded
# Required when any enabled device in sensors_config.json is marked
# "acquisition": "external" (T-10A, JETI serial); the Sensor Agent posts with it.
SVC_SENSOR_INGEST_TOKEN=

# Halio v3 API on the controller's admin console port (8083), including the
# /api/v3 prefix. The legacy key API on port 8084 is no longer served.
HALIO_API_URL=http://192.0.2.20:8083/api/v3
HALIO_SITE_ID=replace-me
# The v3 API is unauthenticated and reachable only on the trailer LAN. Set a key
# only if the controller is configured to require one.
# HALIO_API_KEY=
