# Local non-container development
SVC_ENVIRONMENT=development
SVC_MIN_DWELL_SECONDS=20
SVC_DATA_DIR=.runtime/development
SVC_CONFIG_DIR=config/development
SVC_DB_BACKUP_INTERVAL_HOURS=0

# Explicit physical-hardware testing overrides. Leave false for normal development.
SVC_DEVELOPMENT_USE_PHYSICAL_T10A=false
SVC_DEVELOPMENT_USE_PHYSICAL_JETI=false
SVC_DEVELOPMENT_USE_PHYSICAL_EKO=false

# Production deployments use docker-compose.yml and an external environment file.
